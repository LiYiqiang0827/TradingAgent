# ============================================
# TradingAgent .gitignore
# ============================================
# 数据库文件太大,不上传
# logs 是运行时生成的,不上传
# Python 字节码和缓存,不上传
# 系统文件,不上传

# ============================================
# 数据和日志(大文件)
# ============================================
**/data/
**/logs/

# ============================================
# Python 缓存
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.venv/
.runtime/

# ============================================
# 系统文件
# ============================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============================================
# Symlinks(2026-09-18 docs/ 实体化,不再用软链接)
# ============================================
# 之前 docs/ 是软链接指向 ~/LLM Wiki/TradingAgent/
# 2026-09-18 改成实体目录:文档物理存放在 ~/TradingAgent/<module>/docs/
# LLM Wiki/TradingAgent 改成软链接指向 ~/TradingAgent/
# 这样只维护一个 git 仓库(TradingAgent),分发给他人没有软链问题

# ============================================
# 编辑器 / IDE
# ============================================
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# ============================================
# 敏感信息(token / 密钥)
# ============================================
*.env
*.key
*token*
*secret*

# ============================================
# 临时文件
# ============================================
*.tmp
*.bak
*.swp
.tmp/
.bak/
