# ============================================
# TradingAgent .gitignore
# ============================================
# 数据库文件太大,不上传
# logs 是运行时生成的,不上传
# Python 字节码和缓存,不上传
# 系统文件,不上传

# ============================================
# 数据和日志(大文件)
# ============================================
**/data/
**/logs/
*.db
*.duckdb
*.sqlite
*.sqlite3
*.jpg
*.jpeg

# ============================================
# Python 缓存
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.venv/
.runtime/
node_modules/

# ============================================
# 系统文件
# ============================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ============================================
# Symlinks(2026-09-18 docs/ 实体化,不再用软链接)
# ============================================
# 之前 docs/ 是软链接指向 ~/LLM Wiki/TradingAgent/
# 2026-09-18 改成实体目录:文档物理存放在 ~/TradingAgent/<module>/docs/
# LLM Wiki/TradingAgent 改成软链接指向 ~/TradingAgent/
# 这样只维护一个 git 仓库(TradingAgent),分发给他人没有软链问题

# ============================================
# 编辑器 / IDE
# ============================================
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# ============================================
# 敏感信息(token / 密钥)
# ============================================
*.env
*.key
*token*
*secret*

# ============================================
# 临时文件
# ============================================
*.tmp
*.bak
*.swp
.tmp/
.bak/

# Market review runtime artifacts (snapshots, reports, acceptance files)
review_runs/

# Plot runtime artifacts
plot/tmp_savepic/*
!plot/tmp_savepic/.gitkeep
policyStudy/policy/题材涨停研究/savepic/*
!policyStudy/policy/题材涨停研究/savepic/.gitkeep

# Local generated research and build artifacts
/outputs/
/.codex-*/
policyStudy/policy/题材涨停研究/research/
policyStudy/policy/题材涨停研究/presentations/
policyStudy/policy/题材涨停研究/watchlist/*.csv

# Canonical MrLi research artifacts (keep generated files local)
/MrLi/outputs/
/MrLi/plot/tmp_savepic/*
!/MrLi/plot/tmp_savepic/.gitkeep
/MrLi/policyStudy/policy/题材涨停研究/savepic/*
!/MrLi/policyStudy/policy/题材涨停研究/savepic/.gitkeep
/MrLi/policyStudy/policy/题材涨停研究/research/
/MrLi/policyStudy/policy/题材涨停研究/presentations/
/MrLi/policyStudy/policy/题材涨停研究/watchlist/*.csv

# Canonical MrLi/MrWu generated review artifacts (keep locally; publish source and review notes only)
/tmp/pdfs/
/MrLi/policyStudy/docs/ma30_reactivation_candidates_202605_202608.csv
/MrWu/docs/ma15_pullback_v21/case_pack_20261008/charts/
/MrWu/docs/ma15_pullback_v21/case_pack_20261008/evidence/access.jsonl
/MrWu/docs/research/mkt_weather_v02_20261005/acceptance/*.csv
/MrWu/docs/research/mkt_weather_v02_20261005/acceptance/*.png
/MrWu/docs/research/mkt_weather_v02_20261005/figures/*.png
/MrWu/docs/research/mkt_weather_v02_20261005/figures/*.svg
/MrWu/docs/research/mkt_weather_v02_20261005/human/
/MrWu/docs/research/mkt_weather_v02_20261005/reproduction/fonts/*.ttf
