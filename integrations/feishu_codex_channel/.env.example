# Dedicated Feishu app. Do not reuse the Hermes Feishu app.
FEISHU_CODEX_APP_ID=
FEISHU_CODEX_APP_SECRET=
FEISHU_CODEX_DOMAIN=feishu

# Comma-separated Feishu open_id values. Empty means deny everyone.
FEISHU_CODEX_ALLOWED_OPEN_IDS=

# Empty model means: inherit the current Codex CLI default.
CODEX_FEISHU_MODEL=
CODEX_FEISHU_REASONING_EFFORT=high
CODEX_FEISHU_SANDBOX=workspace-write
CODEX_FEISHU_APPROVAL_POLICY=never
CODEX_FEISHU_TURN_TIMEOUT_SECONDS=7200
TRADING_AGENT_WORKSPACE=/Users/nickzhang/TradingAgent
CODEX_CLI=/opt/homebrew/bin/codex
FEISHU_CODEX_STATE_DIR=~/.local/share/tradingagent-feishu-codex
FEISHU_CODEX_LOG_LEVEL=INFO
